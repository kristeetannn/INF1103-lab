#conditional control flow: if statement 
food = "fries"
price = 0.0
if food == "Burger":
    print("you choose burger")
    print("please pay 8.00 SGD")
    price = 8.00
elif food == "Pizza":
    print("you choose pizza")
    print("please pay 10.00 SGD")
    price = 10.00
else:
    print("Sorry, we don't have that food item")

#iteration (loop) control: while 
walk_circle = 0
while walk_circle < 10:
    walk_circle = walk_circle + 1
print("walking complete")
print(walk_circle)

#break statement 
walk_circle = 0
for walk_circle in range(1,10):
    print(walk_circle)
    if walk_circle == 5:
        break
print("walking complete")
print(walk_circle)

# continue statement
walk_circle = 0
for walk_circle in range(1,10):
    print(walk_circle)
    if walk_circle == 5:
        continue
print("walking complete")
print(walk_circle)

#function arguments 
#formal arguments: the parameters defined in the function definition
def greet(name):
    print("Hello", name)
#actual arguments: the values passed to the function when it is called
greet("Ali")

#positional arguments: the values are passed to the function in the order they are defined
def create_order(customer, product, quantity):
    print(customer, "ordered", quantity, product)

create_order("Jordan", "Laptop",2) #Jordan ordered 2 Laptop
create_order("Laptop","Jordan", 2)  #Laptop ordered 2 Jordan

#keyword arguments: the values are passed to the function using the parameter names
def create_order(customer, product, quantity):
    print(customer, "ordered", quantity, product)

create_order(customer="Jordan", product="Laptop", quantity=2)  # Jordan ordered 2 Laptop
create_order(quantity=2, product="Laptop", customer="Jordan")  # Jordan ordered 2 Laptop

