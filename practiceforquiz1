#list - index in a sequence 
my_list = ['abc', 123, True, 'fff', [0, 1, 2]]
print(my_list[0])  # Output: 'abc'
print(my_list[-2]) # Output: 'fff'
print(my_list[:5:2]) # Output: ['abc', True, [0, 1, 2]]
print("abc" in my_list) # Output: True

#list operations- update
my_list = ['abc', 123, True, 'fff', [0, 1, 2]]
my_list[2] = False 
print(my_list)

#list operations - add
my_list = ['abc', 123, True, 'fff', [0, 1, 2]]
my_list.append('new_item') # adds 'new_item' to the end of the list
my_list.insert(2, 'inserted_item') # inserts 'inserted_item' at index 2
print(my_list)

#list operations - delete
my_list = ['abc', 123, True, 'fff', [0, 1, 2]]
del my_list[1] # deletes the item at index 1
print(my_list)

#list operations - remove
my_list = ['abc', 123, True, 'fff', [0, 1, 2]]
my_list.remove(123) # removes the first occurrence of 123 from the list
print(my_list)

