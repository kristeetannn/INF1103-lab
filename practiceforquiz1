#copying list - copy()
list1 = [10,20,30]
list2 = list1.copy() # creates a shallow copy of list1
list2[0] = 99
print(list1) # Output: [10, 20, 30]
print(list2) # Output: [99, 20, 30]

#copying list - list()
list1 = [10,20,30]
list2 = list(list1) # creates a shallow copy of list1
print(list1) # Output: [10, 20, 30]
print(list2) # Output: [10, 20, 30]

#copying list - deepCopy()
import copy
list1 = [[1, 2], [3, 4]]
list2 = copy.deepcopy(list1) # creates a deep copy of list1
list2[0][0] = 99
print(list1) # Output: [[1, 2], [3, 4]] 

